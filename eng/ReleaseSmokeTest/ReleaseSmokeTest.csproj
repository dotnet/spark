<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>SparkReleaseSmokeTest</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Spark" Version="[$(SparkPackageVersion)]" />
  </ItemGroup>
  <Target Name="RequireSparkPackageVersion" BeforeTargets="CollectPackageReferences">
    <Error Condition="'$(SparkPackageVersion)' == ''" Text="Specify the release candidate's SparkPackageVersion." />
  </Target>
</Project>
